    "comments": 2,
    "reposts": 0,
    "likes": 19,
    "views": "640",
    "pinned": false,
    "visible": true,
    "replyTo": null
  },
  {
    "id": 18,
    "userId": "mob_019",
    "text": "仕事帰りに見上げた夜空の月がやけに綺麗だった。たまには空見上げるのも大事だねえ。",
