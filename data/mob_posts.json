    "timestamp": "5時間前",
    "comments": 6,
    "reposts": 2,
    "likes": 55,
    "views": "2.4千",
    "pinned": false,
    "visible": true,
    "replyTo": null
  },
  {
    "id": 25,
    "userId": "mob_062",
    "text": "スマホの画面フィルム、貼るの失敗して気泡が盛大に入った。もうこのまま生きる。",
