    "timestamp": "4時間前",
    "comments": 1,
    "reposts": 0,
    "likes": 21,
    "views": "830",
    "pinned": false,
    "visible": true,
    "replyTo": null
  },
  {
    "id": 20,
    "userId": "mob_025",
    "text": "久々に筋トレしたら、すでに身体中がバキバキに痛い。明日起き上がれる自信がない。",
