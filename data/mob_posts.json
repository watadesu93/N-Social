    "timestamp": "4時間前",
    "comments": 3,
    "reposts": 0,
    "likes": 41,
    "views": "1.8千",
    "pinned": false,
    "visible": true,
    "replyTo": null
  },
  {
    "id": 42,
    "userId": "mob_063",
    "text": "テレビのチャンネル変えたら、昔めちゃくちゃ好きだったアニメの映画やってて見入っちゃった。",
