    "reposts": 4,
    "likes": 92,
    "views": "4.2千",
    "pinned": false,
    "visible": true,
    "replyTo": null
  },
  {
    "id": 29,
    "userId": "mob_046",
    "text": "ずっと行きたかった展覧会、最終日に滑り込めて本当によかった。感性が刺激された〜。",
