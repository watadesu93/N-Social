    "timestamp": "3時間前",
    "comments": 2,
    "reposts": 0,
    "likes": 15,
    "views": "610",
    "pinned": false,
    "visible": true,
    "replyTo": null
  },
  {
    "id": 40,
    "userId": "mob_092",
    "text": "ずっと気になってたカフェに行けた！内装もおしゃれだしコーヒーも美味しくて大満足。",
