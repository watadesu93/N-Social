    "comments": 0,
    "reposts": 1,
    "likes": 32,
    "views": "1.2千",
    "pinned": false,
    "visible": true,
    "replyTo": null
  },
  {
    "id": 41,
    "userId": "mob_031",
    "text": "夕方にうたた寝しちゃって、起きた時の「ここどこ？何時？」っていう感覚が苦手すぎる。",
